# ==============================================================================
# SMART CAMPUS RESOURCE & MAINTENANCE MANAGEMENT SYSTEM - ENVIRONMENT CONFIG
# ==============================================================================

# 1. PostgreSQL Relational Database URL (Authoritative business records)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=require
# If left empty in local preview, the application automatically uses embedded PostgreSQL 16 WASM.
DATABASE_URL="postgresql://campus_admin:campus_secure_password@localhost:5432/smart_campus"

# 2. MongoDB NoSQL Document Store (Activity timeline and outbox event stream)
# Format: mongodb://[username:password@]host[:port]/database
# If unconfigured, the system safely buffers events in the PostgreSQL outbox_events table.
MONGODB_URI="mongodb://localhost:27017/smart_campus_events"
MONGODB_DB_NAME="smart_campus_events"

# 3. Gemini API Key (Server-side text-embedding-004 vector similarity generation)
# Handled securely via server-side process.env.GEMINI_API_KEY. Never expose in client code.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# 4. Application Host URL
APP_URL="http://localhost:3000"
